# Configure one real provider, or a local LiteLLM-supported endpoint.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LITELLM_API_KEY=
# LITELLM_API_BASE=http://localhost:11434
LITELLM_MODEL=gpt-4o
SQLITE_DB_PATH=verboisy.db
VERBOISY_LOG_LEVEL=INFO
VERBOISY_HEADLESS=true
BROWSER_SANDBOX=true
ALLOW_PRIVATE_NETWORK=false
# ALLOWED_DOMAINS=["example.com","static.example.com"]
MAX_STEPS=20
MAX_TOKENS=4096
MAX_TOTAL_TOKENS=1000000
RUN_TIMEOUT_SECONDS=900
LLM_TIMEOUT_SECONDS=60
LLM_RETRIES=2
BROWSER_TIMEOUT_MS=30000
BROWSER_ACTION_TIMEOUT_MS=10000
MAX_ACTION_FAILURES=3
# google: legacy browser search; may be blocked. brave: supported search API.
# disabled: reject SEARCH actions for runs using known source URLs.
SEARCH_PROVIDER=google
# BRAVE_SEARCH_API_KEY=
SEARCH_TIMEOUT_SECONDS=30
ACTION_DELAY_SECONDS=0.5
USER_AGENT_ROTATION=true
MAX_DOM_CHARS=20000
TEMPERATURE=0.0
