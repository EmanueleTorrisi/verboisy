# Configure the provider credentials locally. Never commit a populated .env.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LITELLM_API_KEY=
# LITELLM_API_BASE=
LITELLM_MODEL=gpt-4o
SQLITE_DB_PATH=verboisy-research.db
VERBOISY_LOG_LEVEL=INFO
VERBOISY_HEADLESS=true
BROWSER_SANDBOX=true
BROWSER_AUTO_INSTALL=true
ALLOW_PRIVATE_NETWORK=false
# Local ingestion is denied unless a canonical file resides under an explicit root.
# DATASET_LOCAL_ROOTS='["/srv/verboisy-inputs"]'
# Internal HTTP sources still require ALLOWED_DOMAINS and explicit network policy.
# Header profiles are exact HTTP(S) origins, including effective port.
# DATASET_HTTP_HEADERS='{"https://internal.example":{"Authorization":"Bearer replace-locally"}}'
USER_AGENT_ROTATION=false
SEARCH_PROVIDER=auto
# BRAVE_SEARCH_API_KEY=
SEARCH_TIMEOUT_SECONDS=30
MAX_STEPS=20
MAX_TOKENS=4096
# Explicit Chat Completions parameter; choose max_completion_tokens if required.
LLM_TOKEN_LIMIT_PARAMETER=max_tokens
# Use prompt only when the selected model cannot accept response_format.
LLM_RESPONSE_MODE=json_object
# Optional model-prefix profiles; longest prefix wins, including role overrides.
# Profile keys/endpoints do not inherit global keys/endpoints. See docs/providers.md.
# LLM_PROVIDER_PROFILES='{"openai/local-model":{"api_base":"http://127.0.0.1:8000/v1","response_mode":"prompt","max_tokens":4096,"send_temperature":false}}'
# Conservative request units: UTF-8 message bytes + max output tokens per attempt.
# This is not the provider's billed token count. Accounting persists across resume.
MODEL_REQUEST_BUDGET=300000
# Optional per-run search attempts across providers; 0 disables provider requests.
# Failed/cancelled attempts count, and resume retains the count.
# SEARCH_REQUEST_BUDGET=20
LLM_MIN_INTERVAL_SECONDS=1
LLM_TIMEOUT_SECONDS=60
LLM_RETRIES=2
RUN_TIMEOUT_SECONDS=900
BROWSER_TIMEOUT_MS=30000
BROWSER_ACTION_TIMEOUT_MS=10000
ACTION_DELAY_SECONDS=0.5
MAX_DOM_CHARS=20000
MAX_SNAPSHOT_CHARS=120000
MAX_PAGE_BYTES=5000000
TEMPERATURE=0.0
# Set false to omit temperature from Chat Completions requests.
LLM_SEND_TEMPERATURE=true

# Defaults for new runs. Saved run choices take precedence on resume; explicit
# --mass-unit, --length-unit and --date-format options override either source.
VERBOISY_MASS_UNIT=kg
VERBOISY_LENGTH_UNIT=m
VERBOISY_DATE_FORMAT=dmy
