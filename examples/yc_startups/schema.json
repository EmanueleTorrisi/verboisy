{
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1,
        "description": "The company name exactly as shown"
      },
      "website": {
        "type": "string",
        "format": "uri",
        "pattern": "^https?://",
        "description": "Actual company website href"
      },
      "description": {
        "type": "string",
        "description": "The company description or tagline from the page"
      },
      "batch": {
        "type": "string",
        "description": "Actual batch from the company card, not the requested filter"
      }
    },
    "required": [
      "name",
      "website"
    ],
    "additionalProperties": false
  }
}
